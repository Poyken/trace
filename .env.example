# 1. Google Gemini AI API Key (Required for AI Operations Copilot)
# Get your key from: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Hybrid On-Premise Relay (Cloudflare Tunnel URL or Local IP)
# Example: https://mes-relay.your-tunnel.trycloudflare.com or http://localhost:5000
# When left empty, Web Portal safely uses Domain-Engineered Mock Fallback data.
MES_RELAY_URL=

# 3. Authentication Secret Token for Relay API
MES_RELAY_SECRET=vinatech_secret_token_2026
